{
  "project": "AquaGuard",
  "version": "2.0",
  "sampling_interval_minutes": 5,
  "minimum_history_minutes": 60,
  "deterioration": {
    "features_file": "deterioration_feature_list.json",
    "models": {
      "2h": "xgb_deterioration_2h_v2.joblib",
      "4h": "xgb_deterioration_4h_v2.joblib",
      "6h": "xgb_deterioration_6h_v2.joblib",
      "8h": "xgb_deterioration_8h_v2.joblib"
    },
    "thresholds": {
      "2h": 0.45,
      "4h": 0.315,
      "6h": 0.49957973351984314,
      "8h": 0.7000000000000001
    },
    "right_censoring_used": true,
    "time_position_feature_removed": true,
    "dashboard_probability_monotonicization": "cumulative maximum across 2h/4h/6h/8h"
  },
  "sensor_anomaly": {
    "features_file": "anomaly_feature_list.json",
    "primary_model": "xgb_sensor_anomaly_v2.joblib",
    "xgboost_model": "xgb_sensor_anomaly_v2.joblib",
    "xgboost_threshold": 0.8150000000000001,
    "isolation_forest_baseline": "isolation_forest_baseline_v2.joblib",
    "isolation_forest_scaler": "isolation_forest_scaler_v2.joblib",
    "isolation_forest_threshold": 0.5143046261786707
  },
  "safety_statement": "Predictions represent deterioration risk in monitored sensor indicators and sensor-behaviour anomalies. They do not certify drinking-water safety."
}